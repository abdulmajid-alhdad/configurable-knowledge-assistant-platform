# Production composition. Invalid or incomplete production configuration fails startup.
KNOWLEDGE_PLATFORM_MODE=production
PLATFORM_DATABASE_DSN=

# Provider-neutral remote embedding gateway (current reference deployment: OpenRouter BGE-M3).
EMBEDDING_ENDPOINT=https://openrouter.ai/api/v1/embeddings
EMBEDDING_MODEL_REFERENCE=baai/bge-m3
EMBEDDING_CREDENTIAL_REFERENCE=OPENROUTER_API_KEY
EMBEDDING_DIMENSIONS=1024

# Provider-neutral remote generation gateway (current reference deployment: OpenRouter Mistral Nemo).
MODEL_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
MODEL_REFERENCE=mistralai/mistral-nemo
MODEL_CREDENTIAL_REFERENCE=OPENROUTER_API_KEY
OPENROUTER_API_KEY=

# Supabase Auth is called server-side. Never expose a service-role key to the browser.
SUPABASE_AUTH_URL=https://PROJECT_REF.supabase.co/auth/v1
SUPABASE_PUBLISHABLE_KEY=
# Backend only. Never expose this Supabase secret key to browser code.
SUPABASE_SECRET_KEY=
SESSION_COOKIE_SECURE=true

# Explicit private-data egress approval is required for remote inference.
EXTERNAL_PRIVATE_DATA_ALLOWED=false

KNOWLEDGE_ARTIFACT_ROOT=/var/lib/knowledge-platform/artifacts
KNOWLEDGE_MAX_ARTIFACT_BYTES=10000000

# Current calibrated reference default; evaluate deployment-specific corpora independently.
MAX_RETRIEVAL_DISTANCE=0.4
